{
  "name": "relatasoft-openclaw-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RelataSoft OpenClaw Control — private GPT Actions bridge to a local OpenClaw gateway",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build && pnpm -r --filter=./apps/* run build",
    "dev:gateway": "pnpm --filter @relatasoft/action-gateway dev",
    "dev:bridge": "pnpm --filter @relatasoft/mac-bridge dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.16.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
