# virtualmin-snappymail
# Webmin / Virtualmin GUI module — manage SnappyMail as a web-only webapp.
#
# Installed automatically by: sudo bash bin/install-to-system.sh
# Or manually:
#   cp -a webmin/virtualmin-snappymail /usr/share/webmin/virtualmin-snappymail
#   Then enable under Virtualmin → System Settings → Features and Plugins.

name=SnappyMail
category=Virtualmin
desc=SnappyMail webmail manager (web-only subservers)
version=0.2.0
os_support=*
depends=virtual-server
readonly=0
longdesc=Install, diagnose, upgrade and remove SnappyMail as a web-only Virtualmin sub-server (webmail.domain) bound to the parent mail domain. Acts as a managed webapp: full-copy install, Virtualmin backup unit, CLI-backed UI.
