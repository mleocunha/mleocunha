# Action Gateway
NODE_ENV=development
PORT=8788
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8788
DATABASE_PATH=./data/control.db
LOG_LEVEL=info

# SHA-256 hex of the GPT Action bearer token (never store the raw token)
# Generate: node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "<token>"
GPT_ACTION_TOKEN_HASH=

# Ed25519 public key (base64) for the registered Mac Bridge device
DEVICE_ID=macbook-mauro
DEVICE_PUBLIC_KEY=

# Shared HMAC secret (base64, 32+ bytes) used to sign command envelopes
COMMAND_SIGNING_SECRET=

APPROVAL_TTL_SECONDS=300
COMMAND_TTL_SECONDS=60
MAX_BODY_BYTES=262144
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Mac Bridge (credentials live in Keychain on macOS; env only for local/dev)
GATEWAY_WS_URL=ws://127.0.0.1:8788/v1/device/connect
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_MODE=mock
DEVICE_PRIVATE_KEY=
BRIDGE_DEVICE_ID=macbook-mauro
