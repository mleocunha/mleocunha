{
  "name": "relatasoft/secure-election-suite",
  "description": "Voto Eletrônico by RelataSoft — Secure Election Suite",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "RelataSoft\\SecureElectionSuite\\Painel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RelataSoft\\SecureElectionSuite\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "piloto": "php bin/ve-node pilot --root=/tmp/ve-piloto --votes=2"
  },
  "bin": [
    "bin/ve-node",
    "bin/ve-http"
  ]
}
